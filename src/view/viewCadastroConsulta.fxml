      </Button>
      <Button fx:id="btCancelar" layoutX="646.0" layoutY="468.0" mnemonicParsing="false" onAction="#actionCancelar" prefHeight="45.0" prefWidth="143.0" style="-fx-background-color: #BC3333; -fx-background-radius: 10;" text="Cancelar" textFill="WHITE">
