      </Text>
      <TextField fx:id="txtNomPacient" layoutX="183.0" layoutY="88.0" onKeyPressed="#actionCPFType" onKeyTyped="#actionCPFType" onMouseClicked="#actionCPFClick" prefHeight="35.0" prefWidth="320.0" style="-fx-background-radius: 15;" />
      <Text layoutX="520.0" layoutY="110.0" strokeType="OUTSIDE" strokeWidth="0.0" text="CPF:">
