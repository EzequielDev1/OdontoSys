      </Text>
      <TextField fx:id="txtObs" layoutX="155.0" layoutY="309.0" prefHeight="80.0" prefWidth="600.0" />
      <Button fx:id="btSalvar" layoutX="436.0" layoutY="468.0" mnemonicParsing="false" onAction="#actionSalvar" prefHeight="45.0" prefWidth="143.0" style="-fx-background-color: #009000; -fx-background-radius: 10;" text="Salvar" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font size="18.0" />
